PORT=4000
NODE_ENV=development
ALLOWED_ORIGIN=*

# Core security
JWT_SECRET=dev-jwt-secret-change-in-production
TOKEN_TTL_SECONDS=3600
STRIPE_WEBHOOK_SECRET=whsec_dev
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_WEBHOOK_MAX_FUTURE_SECONDS=60

# Auth provider
# AUTH_MODE=dev uses email login for local development only.
# AUTH_MODE=oidc verifies provider-issued JWTs from Auth0/Cognito/Clerk.
# If unset, server defaults to dev outside production and oidc in production.
AUTH_MODE=dev
# Example Auth0 issuer: https://your-tenant.us.auth0.com/
AUTH_OIDC_ISSUER=
# Example audience: https://api.streetsmart.io
AUTH_OIDC_AUDIENCE=
# Optional override; leave blank to use ${AUTH_OIDC_ISSUER}/.well-known/jwks.json
AUTH_OIDC_JWKS_URI=
# Role claim used for RBAC extraction. Supports string or array claims.
AUTH_OIDC_ROLE_CLAIM=role
DEV_ADMIN_EMAILS=admin@example.com

# Database and durable queue/audit
DATABASE_URL=postgres://streetsmart:devpassword@localhost:5432/streetsmart
DB_POOL_MAX=10
PG_BOSS_SCHEMA=pgboss

# S3-compatible upload signing (AWS SDK v3)
FILE_BUCKET_BASE_URL=https://example-bucket.local
FILE_BUCKET_NAME=streetsmart-dev
FILE_BUCKET_REGION=us-east-1
FILE_BUCKET_ENDPOINT=
FILE_BUCKET_KEY_PREFIX=uploads
FILE_BUCKET_PRESIGN_EXPIRES_SECONDS=300
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Audit forwarding hook (optional SIEM endpoint)
AUDIT_FORWARD_URL=
AUDIT_FORWARD_BATCH_SIZE=100
AUDIT_FORWARD_INTERVAL_MS=10000
AUDIT_SPOOL_FILE_PATH=/tmp/streetsmart-audit-events.ndjson

# API rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
